{
    "name": "agenticdome-openclaw-security",
    "version": "1.0.6",
    "description": "AgenticDome action firewall for OpenClaw prompt, tool, delegation, and transcript boundaries",
    "license": "Apache-2.0",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        },
        "./firewall": {
            "types": "./dist/firewall.d.ts",
            "import": "./dist/firewall.mjs",
            "require": "./dist/firewall.cjs"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE",
        "NOTICE",
        "CONTRIBUTING.md",
        "SECURITY.md",
        "openclaw.plugin.json",
        "skills",
        "docs",
        "examples"
    ],
    "scripts": {
        "clean": "rm -rf dist",
        "typecheck": "tsc --noEmit",
        "build": "tsup",
        "test": "npm run build && node --test test/*.test.mjs && node test/openclaw-cli-smoke.mjs",
        "prepublishOnly": "npm run clean && npm run typecheck && npm test && npm run build",
        "test:openclaw-real": "npm run build && node --test test/openclaw-real-compat.test.mjs",
        "test:openclaw-cli": "npm run build && node test/openclaw-cli-smoke.mjs",
        "test:live-tenant": "npm run build && AGENTICDOME_LIVE_TENANT_TEST=1 node --test test/live-tenant.test.mjs",
        "test:release": "npm run typecheck && npm test && npm run test:live-tenant && npm pack --dry-run"
    },
    "dependencies": {
        "agenticdome-sdk": "^0.6.7"
    },
    "devDependencies": {
        "@types/node": "^22.10.2",
        "esbuild": "^0.28.1",
        "tsup": "^8.3.5",
        "typescript": "^5.7.2"
    },
    "engines": {
        "node": ">=22.22.3 <23 || >=24.15.0 <25 || >=25.9.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "homepage": "https://github.com/agenticdome/agenticdome-openclaw-security-ts#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/agenticdome/agenticdome-openclaw-security-ts.git"
    },
    "bugs": {
        "url": "https://github.com/agenticdome/agenticdome-openclaw-security-ts/issues"
    },
    "openclaw": {
        "extensions": [
            "./dist/index.mjs"
        ],
        "compat": {
            "pluginApi": ">=2026.7.1-2"
        },
        "build": {
            "openclawVersion": "2026.8.1",
            "pluginSdkVersion": "2026.8.1"
        },
        "install": {
            "npmSpec": "agenticdome-openclaw-security@1.0.6",
            "minHostVersion": ">=2026.7.1-2"
        }
    },
    "overrides": {
        "esbuild": "^0.28.1"
    }
}
